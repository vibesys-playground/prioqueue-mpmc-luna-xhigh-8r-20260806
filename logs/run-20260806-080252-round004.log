      25		buffer    bytes.Buffer
      26		remaining int
      27	}
      28	
      29	func newBoundedLog(limit int) *boundedLog {
      30		return &boundedLog{remaining: limit}
      31	}
      32	
      33	func (w *boundedLog) Write(value []byte) (int, error) {
      34		w.mu.Lock()
      35		defer w.mu.Unlock()
      36		original := len(value)
      37		if len(value) > w.remaining {
      38			value = value[:w.remaining]
      39		}
      40		_, _ = w.buffer.Write(value)
      41		w.remaining -= len(value)
      42		return original, nil
      43	}
      44	
