seen=set()
count=0

def step(done,q,order):
    global count
    count+=1
    if len(done)==len(ops):
        print('VALID',order); return True
    for i,op in enumerate(ops):
        if i in done or not pre[i] <= done: continue
        inp=op['input']; out=op['output']; nq=q
        if inp['kind']=='enqueue':
