              let mut published = self.state.published.lock();
  
              // Publication is short-held and only touches heap/index metadata.
              // The payload was fully copied before this lock was acquired.
              published.heap.push(PublishedEntry {
                  priority,
                  slot_index,
              });
          }
          STATUS_OK
      }
  }
  
