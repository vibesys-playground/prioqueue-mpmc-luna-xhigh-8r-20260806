  const STATUS_INTERNAL_ERROR: u32 = 4;
  
  const INLINE_VALUE_CAPACITY: usize = 8;
  
  enum SlotStorage {
      Inline {
          bytes: [u8; INLINE_VALUE_CAPACITY],
          length: usize,
      },
      Heap(Vec<u8>),
